# Base URL of the apps/api backend (next.config.ts's rewrite of /api/:path*
# and lib/api-server.ts's server-side fetches both read this; the browser
# never talks to it directly — see lib/api.ts). Local dev default shown; in
# production set it to the deployed API's URL (e.g. the Railway service),
# with no trailing slash.
API_URL=http://localhost:8000

# Base URL of THIS deployed app (not the API) — lib/seo.ts's SITE_URL,
# read by the root layout's metadataBase, app/robots.ts, and
# app/sitemap.ts to build absolute URLs (og:image/canonical links, the
# sitemap's <loc> entries, robots.txt's Sitemap: line). Falls back to
# http://localhost:3000 when unset, so local dev needs nothing here. Set
# to the real production domain once one exists (docs/founder-todo.md
# tracks the domain purchase) — no trailing slash. Like every NEXT_PUBLIC_*
# var, Next.js inlines this at `next build` time and freezes it — setting
# or changing it after the first deploy does nothing until the next
# deploy (docs/founder-todo.md's Vercel entry has the full explanation,
# same caveat as API_URL there).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Better Auth (apps/web/lib/auth.ts). High-entropy secret, min 32 chars.
# REQUIRED for `npm run build`/`npm start` (production mode) — Better Auth
# throws at startup without one, unlike AUTH_JWT_SECRET below, which this
# app deliberately made optional. `npm run dev` is fine without it (Better
# Auth falls back to an insecure built-in dev default) but set it anyway if
# you want sessions to survive a dev-server restart.
# BETTER_AUTH_SECRET=
# Base URL of this app; only needed if Better Auth can't infer it from the
# incoming request (e.g. behind certain proxies). Usually leave unset.
# BETTER_AUTH_URL=http://localhost:3000
# Test-only override for Better Auth's SQLite file path (defaults to
# .data/auth.db) — lets tests point at an isolated ":memory:" database
# instead of the real dev file (see tests/auth-token-route.test.ts). Never
# set this in dev or production; leave unset.
# BETTER_AUTH_DB_PATH=

# Web<->API bridge token (apps/web/app/auth/token/route.ts). MUST be the
# exact same value as apps/api's AUTH_JWT_SECRET — this app signs the
# tokens that API verifies. Left unset, sign-in still works (magic
# link/Google), but every API call from a signed-in user goes out
# anonymously, same as before this feature — never a crash.
# AUTH_JWT_SECRET=

# Optional Google sign-in (apps/web/lib/auth.ts). The button is omitted
# from /signin entirely — not shown-and-disabled — unless BOTH are set.
# console.cloud.google.com → OAuth client credentials.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# SMTP transport for magic-link email — NOT implemented yet (see
# docs/founder-todo.md). Do NOT set this until an SMTP transport is
# implemented (founder-todo tracks it): lib/auth.ts gates on this var's
# mere presence and, once set, THROWS on every magic-link send attempt
# instead of sending one — it does not fall back to the console
# transport. Leave unset: in dev, magic links are logged to the server
# console instead ("MAGIC_LINK: <url>"). Today's production does NOT log
# them anywhere, set or unset — it deliberately fails closed
# (magic_link_transport_unconfigured, apps/web/lib/auth.ts) rather than
# print a live single-use credential to server logs, so production
# magic-link sign-in stays off until a real transport ships.
# EMAIL_HOST=
