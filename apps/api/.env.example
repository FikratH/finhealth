# Backend configuration (no secrets are committed to the repository)
MAX_FILE_SIZE_MB=15
# Hard cap on any request's raw body, enforced by ASGI middleware
# (app/body_limit.py, P7.T2) before the body is read into memory —
# independent of, and above, MAX_FILE_SIZE_MB above (that's a per-document
# rule with its own error message; this is a blanket memory-safety rule
# for every route). Over the limit: 413 {code:"payload_too_large"}.
# MAX_BODY_BYTES=16777216
# Structured logging (app/logging_setup.py, P7.T2): "text" (default) is a
# human-readable line for local dev; "json" is one JSON object per line —
# what a production log viewer (e.g. Railway's) parses. Every line carries
# ts/level/logger/msg/request_id, plus path/method/status/duration_ms on
# the one summary line per request.
# LOG_FORMAT=text
ALLOWED_ORIGINS=http://localhost:3000
FINHEALTH_DB=./app.db
# Postgres connection string (app/storage.py's database_url()). When set,
# this wins over FINHEALTH_DB above and the app connects to Postgres
# instead of the local SQLite file — this is the actual production DB
# swap (e.g. Neon). Unset means SQLite. Driver is psycopg (v3, requirements.txt)
# — the URL scheme MUST be "postgresql+psycopg://", not bare "postgresql://"
# or "postgres://" (Neon's dashboard gives you the bare form): SQLAlchemy
# defaults a schemeless "postgresql://" to the psycopg2 dialect, which
# isn't installed, and that fails at engine creation, not at connect time.
# Rewrite the scheme prefix before pasting Neon's string in here. See
# docs/founder-todo.md's Neon section for first-use verification steps
# (UNTESTED-LIVE — never run against a real Postgres database).
# DATABASE_URL=
# Per-request wall-clock budget (seconds) for document extraction
# (app/main.py) before the spawn-context worker process is killed and a
# 422 "too complex to parse in time" is returned. 90s default comfortably
# covers normal PDFs/spreadsheets; only raise it if legitimate uploads are
# being timed out.
# EXTRACT_TIMEOUT_SECONDS=90
# Per-IP token bucket rate limiter (app/ratelimit.py) on POST /api/upload,
# /api/extract, /api/analyze, and /api/analysis/{id}/narrative. Off by
# default (0/unset) — set to a positive integer to cap requests per minute
# per client IP; over the limit returns 429 {code:"rate_limited"}. In-memory
# only, so this is per-process: correct for a single API instance, not
# meaningful behind multiple instances without a shared store.
# RATE_LIMIT_PER_MINUTE=0
# Optional JWT auth (apps/api/app/auth.py). Bearer tokens are verified
# (HS256, iss="tonus-web", aud="tonus-api") but never required — absent
# means every request is treated as anonymous, not an error. MUST be the
# exact same value as apps/web's AUTH_JWT_SECRET (it signs the tokens this
# API verifies); a mismatch silently makes every token look invalid, not a
# crash.
# AUTH_JWT_SECRET=
# Optional document vault (app/services/vault.py, P5.T7). POST /api/upload's
# `retain=1` form field (requires a signed-in user) is rejected with a 503
# {code:"vault_unavailable"} until this is set — off by default, matching
# the product's privacy-default posture. VAULT_ENABLED=1 turns retention on
# and uses local disk (apps/api/.data/vault/, gitignored — durable enough
# for dev, NOT for a redeploy-wipes-the-disk production host) unless
# R2_ACCOUNT_ID/R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY/R2_BUCKET are ALL also
# set, in which case Cloudflare R2 (S3-compatible, via boto3) is used
# instead. GET/DELETE /api/my/documents (viewing/deleting a user's own
# already-retained documents) work regardless of VAULT_ENABLED — the flag
# only gates offering NEW retention on upload.
# VAULT_ENABLED=0
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# Optional LLM narrative layer (POST /api/analysis/{id}/narrative). The app
# is fully functional without it — the score, ratios, risk radar, and
# recommendations are always computed locally and deterministically; the
# LLM (when configured) only narrates prose AROUND those numbers, never
# computes any itself. Provider-agnostic: any OpenAI-compatible endpoint.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=
