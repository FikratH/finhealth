# Backend configuration (no secrets are committed to the repository)
MAX_FILE_SIZE_MB=15
ALLOWED_ORIGINS=http://localhost:3000
FINHEALTH_DB=./app.db
# Optional LLM narrative layer (POST /api/analysis/{id}/narrative). The app
# is fully functional without it — the score, ratios, risk radar, and
# recommendations are always computed locally and deterministically; the
# LLM (when configured) only narrates prose AROUND those numbers, never
# computes any itself. Provider-agnostic: any OpenAI-compatible endpoint.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=
